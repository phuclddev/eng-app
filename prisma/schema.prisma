generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  PENDING
  APPROVED
  BLOCKED
}

enum PracticeMode {
  LEARN
  REVIEW
  MIXED
}

enum ExerciseType {
  MULTIPLE_CHOICE
  FILL_IN_BLANK
  VI_TO_CHUNK
  REWRITE_SENTENCE
  CREATE_SENTENCE
}

enum ConfidenceLevel {
  EASY
  MEDIUM
  HARD
}

enum IeltsSkill {
  SPEAKING
}

enum IeltsTaskType {
  PART_1
  PART_2
  PART_3
}

enum QuestionChunkUsageRole {
  HOOK
  MAIN_IDEA
  SUPPORTING_DETAIL
  EXAMPLE
  OPINION
  CLOSING
}

enum AiConversationPurpose {
  GENERAL_CHAT
  SENTENCE_CORRECTION
  SPEAKING_COACH
  CHUNK_EXPLANATION
}

enum AiSimulatorPart {
  PART_1
  PART_2
  PART_3
  MIXED
}

enum AiSimulatorStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

enum AiSimulatorMessageRole {
  EXAMINER
  LEARNER
  FEEDBACK
}

enum FamilyChildFocus {
  KIWI
  VIVI
  BOTH
}

enum FamilyChunkChildFocus {
  KIWI
  VIVI
  BOTH
  GENERAL
}

enum FamilySpeakerRole {
  FATHER
  CHILD
  MOTHER
  GRANDPARENT
  GENERAL
}

enum FamilyChunkStatus {
  SUGGESTED
  APPROVED
  ARCHIVED
}

enum FamilyPracticeMode {
  DAILY
  REVIEW
  MIXED
}

enum FamilyPracticeExerciseType {
  VI_TO_CHUNK
  FILL_IN_DIALOG
  NATURAL_RESPONSE
  CONTINUE_CONVERSATION
  FAMILY_CHUNK_RECALL
}

enum FamilyRoleplayRole {
  FATHER
  MOTHER
  KIWI
  VIVI
  GRANDPARENT
}

enum FamilyRoleplayStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum FamilyRoleplaySender {
  USER
  AI
}

enum FamilyFavoriteTargetType {
  CONVERSATION
  CHUNK
  ROLEPLAY
  SCENARIO
}

enum TranslationRecallConfidence {
  EASY
  MEDIUM
  HARD
}

model User {
  id               String            @id @default(cuid())
  name             String?
  email            String            @unique
  emailVerified    DateTime?
  image            String?
  role             UserRole          @default(USER)
  status           UserStatus        @default(PENDING)
  notes            String?           @db.Text
  approvedAt       DateTime?
  blockedAt        DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  accounts         Account[]
  sessions         Session[]
  createdChunks    Chunk[]           @relation("ChunkCreator")
  createdQuestions IeltsQuestion[]   @relation("QuestionCreator")
  aiConversations  AiConversation[]
  aiSimulatorSessions AiSimulatorSession[]
  aiStudyCoachSnapshots AiStudyCoachSnapshot[]
  familyChunks      FamilyChunk[]
  familyConversations FamilyConversation[]
  familyProfile    FamilyProfile?
  familyScenarios  FamilyScenario[]
  familyPracticeSessions FamilyPracticeSession[]
  familyPracticeAnswers FamilyPracticeAnswer[]
  familyReviewSchedules FamilyReviewSchedule[]
  familyRoleplaySessions FamilyRoleplaySession[]
  familyFavorites        FamilyFavorite[]
  familyDailyPlanSnapshots FamilyDailyPlanSnapshot[]
  translationScripts     TranslationScript[]            @relation("TranslationScriptCreator")
  translationReviews     TranslationSentenceReview[]
  practiceAnswers  PracticeAnswer[]
  practiceSessions PracticeSession[]
  reviewSchedules  ReviewSchedule[]

  @@index([role, status])
}

model FamilyProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  title           String   @db.VarChar(191)
  profileMarkdown String   @db.LongText
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([isActive])
}

model FamilyScenario {
  id            String           @id @default(cuid())
  userId        String
  title         String           @db.VarChar(191)
  category      String           @db.VarChar(120)
  childFocus    FamilyChildFocus @default(BOTH)
  description   String           @db.Text
  difficulty    Int              @default(1)
  isActive      Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversations FamilyConversation[]
  roleplaySessions FamilyRoleplaySession[]

  @@unique([userId, title])
  @@index([userId, isActive])
  @@index([userId, category, childFocus])
}

model FamilyConversation {
  id                   String           @id @default(cuid())
  userId               String
  scenarioId           String
  childFocus           FamilyChildFocus @default(BOTH)
  title                String           @db.VarChar(191)
  conversationMarkdown String           @db.LongText
  aiConversationId     String?          @db.VarChar(191)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  user                 User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  scenario             FamilyScenario   @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  chunks               FamilyChunk[]

  @@index([userId, updatedAt(sort: Desc)])
  @@index([scenarioId, createdAt(sort: Desc)])
  @@index([userId, childFocus])
}

model FamilyChunk {
  id                   String               @id @default(cuid())
  userId               String
  text                 String               @db.VarChar(191)
  normalizedText       String               @db.VarChar(191)
  meaningVi            String               @db.VarChar(255)
  usageContext         String               @db.Text
  speakerRole          FamilySpeakerRole    @default(GENERAL)
  childFocus           FamilyChunkChildFocus @default(GENERAL)
  scenarioCategory     String               @db.VarChar(120)
  difficulty           Int                  @default(1)
  frequencyScore       Int                  @default(1)
  personalizationScore Int                  @default(1)
  exampleSentence      String?              @db.Text
  notes                String?              @db.Text
  sourceConversationId String?
  status               FamilyChunkStatus    @default(SUGGESTED)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  sourceRoleplaySessionId String?
  user                 User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceConversation   FamilyConversation?  @relation(fields: [sourceConversationId], references: [id], onDelete: SetNull)
  sourceRoleplaySession FamilyRoleplaySession? @relation(fields: [sourceRoleplaySessionId], references: [id], onDelete: SetNull)
  practiceAnswers      FamilyPracticeAnswer[]
  reviewSchedules      FamilyReviewSchedule[]

  @@unique([userId, normalizedText])
  @@index([userId, status, updatedAt(sort: Desc)])
  @@index([userId, childFocus, speakerRole])
  @@index([sourceConversationId])
  @@index([sourceRoleplaySessionId])
}

model FamilyPracticeSession {
  id                String                       @id @default(cuid())
  userId            String
  mode              FamilyPracticeMode           @default(DAILY)
  exerciseTypes     Json
  totalQuestions    Int                          @default(0)
  correctAnswers    Int                          @default(0)
  score             Int                          @default(0)
  averageResponseMs Int                          @default(0)
  startedAt         DateTime                     @default(now())
  completedAt       DateTime?
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt
  user              User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers           FamilyPracticeAnswer[]

  @@index([userId, startedAt(sort: Desc)])
}

model FamilyPracticeAnswer {
  id              String                       @id @default(cuid())
  sessionId       String
  userId          String
  familyChunkId   String
  exerciseType    FamilyPracticeExerciseType
  prompt          String                       @db.Text
  expectedAnswer  String                       @db.Text
  userAnswer      String                       @db.Text
  isCorrect       Boolean
  responseTimeMs  Int
  confidenceLevel ConfidenceLevel
  feedback        String?                      @db.Text
  createdAt       DateTime                     @default(now())
  session         FamilyPracticeSession        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user            User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyChunk     FamilyChunk                  @relation(fields: [familyChunkId], references: [id], onDelete: Cascade)

  @@index([userId, familyChunkId, createdAt(sort: Desc)])
  @@index([sessionId])
}

model FamilyReviewSchedule {
  id                String           @id @default(cuid())
  userId            String
  familyChunkId     String
  nextReviewAt      DateTime         @default(now())
  lastReviewedAt    DateTime?
  intervalDays      Int              @default(1)
  easeFactor        Float            @default(2.5)
  reviewCount       Int              @default(0)
  lastConfidence    ConfidenceLevel?
  lastCorrect       Boolean?
  masteryScore      Int              @default(0)
  totalAttempts     Int              @default(0)
  correctAttempts   Int              @default(0)
  averageResponseMs Int              @default(0)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyChunk       FamilyChunk      @relation(fields: [familyChunkId], references: [id], onDelete: Cascade)

  @@unique([userId, familyChunkId])
  @@index([userId, nextReviewAt])
}

model FamilyRoleplaySession {
  id                     String                 @id @default(cuid())
  userId                 String
  scenarioId             String?
  userRole               FamilyRoleplayRole
  aiRole                 FamilyRoleplayRole
  childFocus             FamilyChildFocus       @default(BOTH)
  targetLevel            String                 @db.VarChar(24)
  title                  String                 @db.VarChar(191)
  status                 FamilyRoleplayStatus   @default(ACTIVE)
  turnsLimit             Int                    @default(8)
  turnsTaken             Int                    @default(0)
  externalConversationId String?                @db.VarChar(191)
  finalFeedbackMarkdown  String?                @db.LongText
  startedAt              DateTime               @default(now())
  completedAt            DateTime?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  user                   User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  scenario               FamilyScenario?        @relation(fields: [scenarioId], references: [id], onDelete: SetNull)
  messages               FamilyRoleplayMessage[]
  extractedChunks        FamilyChunk[]

  @@index([userId, updatedAt(sort: Desc)])
  @@index([userId, status, updatedAt(sort: Desc)])
  @@index([scenarioId])
}

model FamilyRoleplayMessage {
  id         String                @id @default(cuid())
  sessionId  String
  sender     FamilyRoleplaySender
  roleLabel  String                @db.VarChar(48)
  content    String                @db.Text
  turnNumber Int                   @default(0)
  createdAt  DateTime              @default(now())
  session    FamilyRoleplaySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

model FamilyFavorite {
  id         String                   @id @default(cuid())
  userId     String
  targetType FamilyFavoriteTargetType
  targetId   String                   @db.VarChar(191)
  note       String?                  @db.VarChar(255)
  createdAt  DateTime                 @default(now())
  user       User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetId])
  @@index([userId, targetType, createdAt(sort: Desc)])
}

model FamilyDailyPlanSnapshot {
  id         String           @id @default(cuid())
  userId     String
  childFocus FamilyChildFocus @default(BOTH)
  sourceHash String           @db.VarChar(191)
  answer     String           @db.LongText
  expiresAt  DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, childFocus, updatedAt(sort: Desc)])
  @@index([userId, sourceHash])
}

model TranslationScript {
  id               String                @id @default(cuid())
  title            String                @db.VarChar(191)
  topic            String                @db.VarChar(120)
  bandLevel        Float                 @default(6)
  notes            String?               @db.Text
  fingerprint      String                @unique @db.VarChar(191)
  sourceType       String                @default("MANUAL") @db.VarChar(40)
  sourceQuestionId String?
  generatedByAi    Boolean               @default(false)
  version          Int                   @default(1)
  usedChunkIds     Json?
  createdById      String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  createdBy        User?                 @relation("TranslationScriptCreator", fields: [createdById], references: [id], onDelete: SetNull)
  sourceQuestion   IeltsQuestion?        @relation(fields: [sourceQuestionId], references: [id], onDelete: SetNull)
  sentences        TranslationSentence[]

  @@index([topic, bandLevel])
  @@index([updatedAt(sort: Desc)])
  @@index([sourceQuestionId, bandLevel, version])
  @@index([sourceQuestionId, updatedAt(sort: Desc)])
}

model TranslationSentence {
  id             String                       @id @default(cuid())
  scriptId       String
  orderIndex     Int                          @default(0)
  englishText    String                       @db.Text
  vietnameseText String                       @db.Text
  notes          String?                      @db.Text
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt
  script         TranslationScript            @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  chunkMappings  TranslationChunkMapping[]
  reviews        TranslationSentenceReview[]

  @@unique([scriptId, orderIndex])
  @@index([scriptId])
}

model TranslationChunkMapping {
  id              String              @id @default(cuid())
  sentenceId      String
  chunkId         String?
  englishPhrase   String              @db.VarChar(191)
  meaningVi       String              @db.VarChar(255)
  usageContext    String?             @db.Text
  exampleSentence String?             @db.Text
  suggestedTopic  String?             @db.VarChar(120)
  bandEstimate    Float?
  createdById     String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  sentence        TranslationSentence @relation(fields: [sentenceId], references: [id], onDelete: Cascade)
  chunk           Chunk?              @relation(fields: [chunkId], references: [id], onDelete: SetNull)

  @@unique([sentenceId, englishPhrase])
  @@index([sentenceId])
  @@index([chunkId])
}

model TranslationSentenceReview {
  id             String                      @id @default(cuid())
  userId         String
  sentenceId     String
  reviewCount    Int                         @default(0)
  lastReviewedAt DateTime?
  lastConfidence TranslationRecallConfidence?
  easyCount      Int                         @default(0)
  mediumCount    Int                         @default(0)
  hardCount      Int                         @default(0)
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt
  user           User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  sentence       TranslationSentence         @relation(fields: [sentenceId], references: [id], onDelete: Cascade)

  @@unique([userId, sentenceId])
  @@index([userId, lastReviewedAt(sort: Desc)])
}

model Topic {
  id          String   @id @default(cuid())
  name        String   @unique @db.VarChar(120)
  slug        String   @unique @db.VarChar(140)
  description String?  @db.Text
  color       String?  @db.VarChar(24)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  chunks      Chunk[]

  @@index([name])
}

model Chunk {
  id              String           @id @default(cuid())
  chunk           String           @db.VarChar(191)
  meaningVi       String           @map("meaning_vi") @db.VarChar(255)
  example         String           @db.Text
  wrongExamples   Json?
  difficulty      Int              @default(1)
  bandLevel       Float            @default(6)
  grammarPattern  String?          @db.VarChar(191)
  tags            Json?
  notes           String?          @db.Text
  topicId         String?
  createdById     String?
  deletedAt       DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  topic           Topic?           @relation(fields: [topicId], references: [id], onDelete: SetNull)
  createdBy       User?            @relation("ChunkCreator", fields: [createdById], references: [id], onDelete: SetNull)
  practiceAnswers PracticeAnswer[]
  questionMappings IeltsQuestionChunkMapping[]
  reviewSchedules ReviewSchedule[]
  translationMappings TranslationChunkMapping[]

  @@unique([chunk, meaningVi])
  @@index([deletedAt])
  @@index([topicId, difficulty])
  @@index([bandLevel])
}

model PracticeSession {
  id                String           @id @default(cuid())
  userId            String
  mode              PracticeMode
  exerciseTypes     Json
  totalQuestions    Int              @default(0)
  correctAnswers    Int              @default(0)
  averageResponseMs Int              @default(0)
  startedAt         DateTime         @default(now())
  completedAt       DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers           PracticeAnswer[]

  @@index([userId, startedAt(sort: Desc)])
}

model PracticeAnswer {
  id             String          @id @default(cuid())
  sessionId      String
  userId         String
  chunkId        String
  exerciseType   ExerciseType
  prompt         String          @db.Text
  expectedAnswer String          @db.Text
  userAnswer     String          @db.Text
  isCorrect      Boolean
  responseMs     Int
  confidence     ConfidenceLevel
  feedback       String?         @db.Text
  createdAt      DateTime        @default(now())
  session        PracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  chunk          Chunk           @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  @@index([userId, chunkId, createdAt(sort: Desc)])
  @@index([sessionId])
}

model ReviewSchedule {
  id                String           @id @default(cuid())
  userId            String
  chunkId           String
  nextReviewAt      DateTime         @default(now())
  lastReviewedAt    DateTime?
  intervalDays      Int              @default(1)
  easeFactor        Float            @default(2.5)
  reviewCount       Int              @default(0)
  lastConfidence    ConfidenceLevel?
  lastCorrect       Boolean?
  masteryScore      Int              @default(0)
  totalAttempts     Int              @default(0)
  correctAttempts   Int              @default(0)
  averageResponseMs Int              @default(0)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  chunk             Chunk            @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  @@unique([userId, chunkId])
  @@index([userId, nextReviewAt])
}

model IeltsQuestion {
  id               String                     @id @default(cuid())
  skill            IeltsSkill                @default(SPEAKING)
  taskType         IeltsTaskType
  topic            String                     @db.VarChar(120)
  subTopic         String?                    @db.VarChar(120)
  prompt           String                     @db.Text
  supportingPoints Json?
  difficulty       Int                        @default(1)
  targetBand       Float                      @default(6)
  notes            String?                    @db.Text
  fingerprint      String                     @unique @db.VarChar(191)
  createdById      String?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  createdBy        User?                      @relation("QuestionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  chunkMappings    IeltsQuestionChunkMapping[]
  translationScripts TranslationScript[]

  @@index([skill, taskType, topic])
  @@index([subTopic])
  @@index([difficulty, targetBand])
}

model IeltsQuestionChunkMapping {
  id              String                 @id @default(cuid())
  questionId      String
  chunkId         String
  usageRole       QuestionChunkUsageRole
  exampleSentence String?                @db.Text
  sortOrder       Int                    @default(0)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  question        IeltsQuestion          @relation(fields: [questionId], references: [id], onDelete: Cascade)
  chunk           Chunk                  @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  @@unique([questionId, chunkId, usageRole])
  @@index([questionId, sortOrder])
  @@index([chunkId])
}

model AiConversation {
  id                     String                @id @default(cuid())
  userId                 String
  externalConversationId String                @unique @db.VarChar(191)
  purpose                AiConversationPurpose @default(GENERAL_CHAT)
  title                  String                @db.VarChar(191)
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  user                   User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt(sort: Desc)])
}

model AiSimulatorSession {
  id                     String                @id @default(cuid())
  userId                 String
  part                   AiSimulatorPart
  topic                  String?               @db.VarChar(120)
  prompt                 String?               @db.Text
  targetBand             Float?
  numberOfTurns          Int                   @default(5)
  currentTurn            Int                   @default(0)
  status                 AiSimulatorStatus     @default(ACTIVE)
  externalConversationId String                @unique @db.VarChar(191)
  finalFeedback          String?               @db.Text
  finalFeedbackSections  Json?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  user                   User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages               AiSimulatorMessage[]

  @@index([userId, updatedAt(sort: Desc)])
  @@index([status, part])
}

model AiSimulatorMessage {
  id         String                 @id @default(cuid())
  sessionId  String
  role       AiSimulatorMessageRole
  content    String                 @db.Text
  turnNumber Int                    @default(0)
  createdAt  DateTime               @default(now())
  session    AiSimulatorSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

model AiStudyCoachSnapshot {
  id              String   @id @default(cuid())
  userId          String
  sourceHash      String   @db.VarChar(191)
  answer          String   @db.Text
  structuredPlan  Json?
  expiresAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt(sort: Desc)])
  @@index([userId, sourceHash])
}

model Account {
  id                String   @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
